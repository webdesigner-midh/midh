# Configuration du site institutionnel MIDH
# URL publique de l'application Next.js
NEXT_PUBLIC_SITE_URL=https://midh-ci.org

# Configuration WiniPayer (Agrégateur de paiement Mobile Money & Cartes Bancaires)
WINIPAYER_APPLY_KEY=votre_apply_key_winipayer
WINIPAYER_TOKEN_KEY=votre_token_key_winipayer
WINIPAYER_PRIVATE_KEY=votre_private_key_winipayer
WINIPAYER_ENV=test # 'test' pour le bac à sable, 'prod' pour la production

# URL de l'instance WordPress Headless (laisser vide pour utiliser les données de repli officielles)
# En local : http://localhost:8080
# En production : https://cms.midh-ci.org
NEXT_PUBLIC_WORDPRESS_URL=

# Jeton secret pour le Webhook de revalidation Next.js (doit correspondre à la valeur dans WordPress)
REVALIDATE_SECRET_TOKEN=votre_jeton_secret_de_revalidation

# Clé API optionnelle dédiée au pont WordPress (X-MIDH-Key pour /donations/record ; sinon utilise REVALIDATE_SECRET_TOKEN)
MIDH_WP_BRIDGE_SECRET=

# Clé secrète optionnelle pour signer les liens et PDF de reçus de don (sinon utilise WINIPAYER_PRIVATE_KEY ou REVALIDATE_SECRET_TOKEN)
RECEIPT_SIGNING_SECRET=

# Destinataire des messages du formulaire de contact
CONTACT_FORM_RECIPIENT=brahimacoulibaly7777@gmail.com

# Configuration Resend (Envoi d'e-mails institutionnels & reçus de dons)
RESEND_API_KEY=re_votre_cle_resend
RESEND_FROM_EMAIL=MIDH <info@midh-ci.org>
